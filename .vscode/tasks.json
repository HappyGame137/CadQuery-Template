{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CAD: Live preview",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-u", "${workspaceFolder}/preview.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "runOptions": {"instanceLimit": 1},
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "CAD: Export STEP and STL",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/export.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
